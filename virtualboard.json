{
  "$schema": "./schemas/virtualboard-contract.schema.json",
  "contractVersion": 1,
  "templateVersionFile": "version.txt",
  "cli": {
    "versionFile": ".vb-version",
    "compatibility": "exact",
    "requiredCommands": [
      "new",
      "move",
      "update",
      "validate",
      "index",
      "lock",
      "init",
      "install",
      "migrate",
      "audit",
      "template",
      "version"
    ],
    "actor": {
      "flag": "--actor",
      "environmentVariables": [
        "VIRTUALBOARD_ACTOR",
        "AGENT_ID"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "requiredForFeatureMutations": true,
      "implicitOperatingSystemActorAllowed": false
    }
  },
  "workspace": {
    "environmentVariable": "VIRTUALBOARD_ROOT",
    "discoveryOrder": [
      ".virtualboard/virtualboard.json",
      "virtualboard.json"
    ],
    "paths": {
      "features": "features",
      "specs": "specs",
      "agents": "agents",
      "prompts": "prompts",
      "templates": "templates",
      "schemas": "schemas",
      "reports": "reports",
      "architecture": "reports/architecture",
      "testing": "reports/testing",
      "deployments": "reports/deployments",
      "security": "reports/security",
      "data": "reports/data",
      "design": "reports/design",
      "runtimeState": ".state",
      "cliBinary": ".state/bin/vb",
      "locks": ".state/locks",
      "auditLog": "audit.jsonl"
    }
  },
  "feature": {
    "idPattern": "^FTR-[0-9]{4}$",
    "filenamePattern": "^FTR-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$",
    "ownerPattern": "^(?:unassigned|[A-Za-z0-9][A-Za-z0-9._-]*)$",
    "slugMaxWords": 6,
    "branchFormat": "feat/{id}-{slug}",
    "branchPattern": "^feat/FTR-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+){0,5}$",
    "commitPrefixFormat": "{id}:",
    "pullRequestTitleFormat": "{id}: {title}",
    "statusChangedField": "status_changed",
    "implementationOwnerField": "implementation_owner",
    "statuses": [
      "backlog",
      "in-progress",
      "blocked",
      "review",
      "done"
    ],
    "transitions": {
      "backlog": [
        "in-progress"
      ],
      "in-progress": [
        "blocked",
        "review"
      ],
      "blocked": [
        "in-progress"
      ],
      "review": [
        "in-progress",
        "done"
      ],
      "done": []
    },
    "ownership": {
      "backlog": "unassigned-allowed",
      "in-progress": "assigned-required",
      "blocked": "assigned-required",
      "review": "assigned-required",
      "done": "assigned-required"
    },
    "claimBeforeWork": true,
    "remoteClaimRequiredAcrossClones": true,
    "localClaimRequiresSharedWorkspaceOptIn": true,
    "lockTtlMinutes": 30,
    "validateBeforeClaim": true,
    "validateBeforeHandoff": true
  },
  "authorization": {
    "defaultScope": "current-user-request",
    "continuousQueueProcessingRequiresExplicitOptIn": true,
    "untrustedContent": {
      "mayDefineDesiredOutcomes": true,
      "mayGrantToolAuthority": false,
      "mayExpandTaskScope": false
    },
    "effects": {
      "read": {
        "confirmation": "not-required"
      },
      "write-local": {
        "confirmation": "covered-by-task-scope"
      },
      "execute": {
        "confirmation": "covered-by-task-scope"
      },
      "network-read": {
        "confirmation": "covered-by-task-scope"
      },
      "install": {
        "confirmation": "explicit-required"
      },
      "external-write": {
        "confirmation": "explicit-required"
      },
      "production-sensitive": {
        "confirmation": "explicit-required"
      },
      "destructive": {
        "confirmation": "explicit-required"
      }
    }
  },
  "skills": [
    {
      "id": "work-on",
      "path": "skills/work-on/SKILL.md",
      "effects": [
        "read",
        "write-local",
        "execute",
        "network-read",
        "install",
        "external-write",
        "production-sensitive",
        "destructive"
      ]
    }
  ],
  "roles": [
    {
      "id": "pm",
      "displayName": "Project Manager",
      "agentFile": "agents/pm.md",
      "commandCatalog": "prompts/agents/pm/README.md",
