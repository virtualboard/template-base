{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "owner",
    "implementation_owner",
    "priority",
    "complexity",
    "created",
    "updated",
    "status_changed",
    "labels",
    "dependencies",
    "risk_notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FTR-\\d{4}$",
      "description": "Unique feature identifier"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "description": "Feature title"
    },
    "status": {
      "type": "string",
      "enum": ["backlog", "in-progress", "blocked", "review", "done"],
      "description": "Current feature status"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:unassigned|[A-Za-z0-9][A-Za-z0-9._-]*)$",
      "description": "Current owner (human or agent handle)"
    },
    "implementation_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:unassigned|[A-Za-z0-9][A-Za-z0-9._-]*)$",
      "description": "Implementation assignee retained across reviewer handoff"
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "description": "Feature priority level"
    },
    "complexity": {
      "type": "string",
      "enum": ["XS", "S", "M", "L", "XL"],
      "description": "Feature complexity estimate"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date (YYYY-MM-DD)"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date (YYYY-MM-DD)"
    },
    "status_changed": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of the most recent lifecycle transition (YYYY-MM-DD)"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true,
      "maxItems": 10,
      "description": "Feature labels (kebab-case)"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FTR-\\d{4}$"
      },
      "uniqueItems": true,
      "description": "Feature dependencies"
    },
    "epic": {
      "type": "string",
      "pattern": "^EP-\\d{4}$",
      "description": "Epic identifier"
    },
    "risk_notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Risk assessment notes"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["in-progress", "blocked", "review", "done"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["owner", "implementation_owner"],
        "properties": {
          "owner": {
            "not": {
              "enum": ["unassigned"]
            }
          },
          "implementation_owner": {
            "not": {
              "enum": ["unassigned"]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
